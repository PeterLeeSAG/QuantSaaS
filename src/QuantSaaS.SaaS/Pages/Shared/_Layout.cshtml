<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — QuantSaaS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <a class="sidebar-logo" asp-page="/Index">QS</a>
        <div class="sidebar-nav">
            <a asp-page="/Index" class="@(ViewData["ActivePage"] as string == "Dashboard" ? "active" : "")">
                <span class="nav-icon">📊</span>Dashboard
            </a>
            <a asp-page="/Instances/Index" class="@(ViewData["ActivePage"] as string == "Instances" ? "active" : "")">
                <span class="nav-icon">⚙️</span>Instances
            </a>
            <a asp-page="/Lab/Index" class="@(ViewData["ActivePage"] as string == "Lab" ? "active" : "")">
                <span class="nav-icon">🧬</span>Lab
            </a>
            <a asp-page="/Trades/Index" class="@(ViewData["ActivePage"] as string == "Trades" ? "active" : "")">
                <span class="nav-icon">📋</span>Trades
            </a>
            <a asp-page="/Settings/Index" class="@(ViewData["ActivePage"] as string == "Settings" ? "active" : "")">
                <span class="nav-icon">🔧</span>Settings
            </a>
        </div>
    </nav>

    <!-- Main -->
    <div class="main-wrapper">
        <!-- Topbar -->
        <div class="topbar">
            <span class="topbar-brand">Quant<span>SaaS</span></span>
            <div class="topbar-right">
                <span style="font-size:0.78rem;color:var(--text-muted);">@DateTime.UtcNow.ToString("MMM dd, yyyy") UTC</span>
                <div class="avatar">U</div>
            </div>
        </div>

        <!-- Content -->
        <main class="content">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@page
@model QuantSaaS.SaaS.Pages.Trades.IndexModel
@{
    ViewData["Title"] = "Trade History";
    ViewData["ActivePage"] = "Trades";
}

<div class="page-header">
    <div>
        <div class="page-title">Trade History</div>
        <div class="page-sub">All executed orders · @Model.Vm.TotalCount total records</div>
    </div>
</div>

<!-- Filters -->
<div class="dash-card mb-3">
    <form method="get" class="d-flex gap-3 align-items-end flex-wrap">
        <div>
            <label style="font-size:0.72rem;color:var(--text-muted);display:block;margin-bottom:4px;">Symbol</label>
            <input type="text" name="symbol" value="@Model.Vm.SymbolFilter"
                   placeholder="e.g. BTC/USDT"
                   style="background:var(--main-bg);border:1px solid var(--border);color:var(--text-primary);border-radius:8px;padding:0.4rem 0.75rem;font-size:0.82rem;width:160px;" />
        </div>
        <div>
            <label style="font-size:0.72rem;color:var(--text-muted);display:block;margin-bottom:4px;">Action</label>
            <select name="action" style="background:var(--main-bg);border:1px solid var(--border);color:var(--text-primary);border-radius:8px;padding:0.4rem 0.75rem;font-size:0.82rem;">
                <option value="" selected="@(Model.Vm.ActionFilter == null)">All</option>
                <option value="BUY"  selected="@(Model.Vm.ActionFilter == "BUY")">BUY</option>
                <option value="SELL" selected="@(Model.Vm.ActionFilter == "SELL")">SELL</option>
            </select>
        </div>
        <button type="submit" class="btn-accent">Filter</button>
        <a asp-page="/Trades/Index" class="btn-outline">Reset</a>
    </form>
</div>

<!-- Table -->
<div class="dash-card">
    <table class="dark-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Symbol</th>
                <th>Asset</th>
                <th>Action</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Fee</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Vm.Trades)
            {
                <tr>
                    <td style="color:var(--text-muted);font-size:0.78rem;">@t.FilledAt.ToString("MMM dd yyyy HH:mm")</td>
                    <td style="font-weight:600;">@t.Symbol</td>
                    <td><span class="pill badge-asset-@t.AssetClass.ToString().ToLower()">@t.AssetClass</span></td>
                    <td><span class="pill badge-action-@t.Action.ToLower()">@t.Action</span></td>
                    <td>@t.FilledQty.ToString("F4")</td>
                    <td>$@t.FilledPrice.ToString("N2")</td>
                    <td style="color:var(--text-muted);">$@t.Fee.ToString("N4")</td>
                    <td><span class="pill badge-status-running" style="font-size:0.68rem;">@t.Status</span></td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    @if (Model.Vm.TotalPages > 1)
    {
        <div class="d-flex justify-content-center gap-2 mt-3">
            @for (int p = 1; p <= Model.Vm.TotalPages; p++)
            {
                <a asp-page="/Trades/Index"
                   asp-route-page="@p"
                   asp-route-symbol="@Model.Vm.SymbolFilter"
                   asp-route-action="@Model.Vm.ActionFilter"
                   style="padding:0.3rem 0.7rem;border-radius:6px;font-size:0.78rem;font-weight:600;text-decoration:none;
                          background:@(p == Model.Vm.Page ? "var(--accent)" : "var(--border)");
                          color:@(p == Model.Vm.Page ? "#fff" : "var(--text-muted)");">
                    @p
                </a>
            }
        </div>
    }
</div>
